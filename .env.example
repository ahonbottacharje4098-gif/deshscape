# EmailJS public configuration for the Deshscape contact form
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Cloudflare Turnstile public site key (safe to expose in the browser)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Turnstile secret key (server only; never use the NEXT_PUBLIC_ prefix)
TURNSTILE_SECRET_KEY=
